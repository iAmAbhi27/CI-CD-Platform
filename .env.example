# Copy to .env and fill in. Never commit .env.

# --- Application ---
APP_ENV=local
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cicd
POSTGRES_USER=cicd
POSTGRES_PASSWORD=change-me

# --- Redis (Phase 3+) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Message broker (Phase 2+) ---
BROKER_URL=amqp://guest:guest@localhost:5672

# --- Git provider webhooks ---
GIT_PROVIDER=github
GITHUB_WEBHOOK_SECRET=change-me
GITHUB_TOKEN=

# --- Runner / Docker ---
DOCKER_HOST=unix:///var/run/docker.sock
RUNNER_DEFAULT_IMAGE=maven:3.9-eclipse-temurin-21
RUNNER_MAX_PARALLEL_JOBS=2
RUNNER_JOB_TIMEOUT_MINUTES=30

# --- Artifact / log storage (Phase 3+) ---
ARTIFACT_STORE=local
ARTIFACT_LOCAL_PATH=./data/artifacts
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- Security ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_MINUTES=60
SECRETS_ENCRYPTION_KEY=change-me

# --- Container registry / deploy (Phase 4+) ---
REGISTRY_URL=
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
KUBECONFIG_PATH=

# --- AI (Phase 6) ---
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
